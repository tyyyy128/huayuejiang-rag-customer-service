page {
  height: 100%;
  background: #f5f7fa;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
  color: #1f2937;
}

/* 顶部 */

.header {
  padding: 28rpx 30rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f3;
}

.brand {
  display: flex;
  align-items: center;
}

.logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #1677ff;
  color: #ffffff;

  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-text {
  margin-left: 20rpx;
}

.title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: #111827;
}

.subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8b95a5;
}

.online-status {
  display: flex;
  align-items: center;

  width: fit-content;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;

  background: #f0fdf4;
  border-radius: 100rpx;

  color: #16a34a;
  font-size: 22rpx;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;

  margin-right: 10rpx;

  border-radius: 50%;
  background: #22c55e;
}

/* 聊天区域 */

.chat-list {
  flex: 1;
  height: 0;
  background: #f5f7fa;
}

.chat-inner {
  padding: 30rpx 24rpx 40rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;

  width: 100%;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.assistant-row {
  justify-content: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.avatar {
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20rpx;

  font-size: 26rpx;
  font-weight: 600;
}

.assistant-avatar {
  margin-right: 16rpx;

  background: #1677ff;
  color: #ffffff;
}

.user-avatar {
  margin-left: 16rpx;

  background: #e5e7eb;
  color: #4b5563;
}

.message-bubble {
  max-width: 72%;

  padding: 20rpx 24rpx;

  border-radius: 22rpx;

  font-size: 29rpx;
  line-height: 44rpx;

  word-break: break-all;
  box-sizing: border-box;
}

.assistant-bubble {
  background: #ffffff;
  color: #1f2937;

  border-top-left-radius: 6rpx;

  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
}

.user-bubble {
  background: #1677ff;
  color: #ffffff;

  border-top-right-radius: 6rpx;
}

/* 底部输入区域 */

.composer {
  flex-shrink: 0;

  padding: 18rpx 22rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));

  background: #ffffff;

  border-top: 1rpx solid #e9edf2;
}

.input-row {
  display: flex;
  align-items: center;
}

.message-input {
  flex: 1;

  height: 80rpx;

  padding: 0 24rpx;

  border-radius: 20rpx;

  background: #f3f5f7;

  font-size: 28rpx;
  color: #111827;

  box-sizing: border-box;
}

.input-placeholder {
  color: #a4acb8;
}

.send-button {
  width: 120rpx;
  height: 80rpx;

  margin-left: 16rpx;
  padding: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20rpx;

  background: #dbe6f5 !important;
  color: #8a9aae !important;

  font-size: 27rpx;
  line-height: 80rpx;
}

.send-button::after {
  border: none;
}

.send-button-active {
  background: #1677ff !important;
  color: #ffffff !important;
}

.privacy-tip {
  margin-top: 12rpx;

  text-align: center;

  color: #a0a8b4;
  font-size: 20rpx;
}

.header-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: 18rpx;
}

.header-tools .online-status {
  margin-top: 0;
}

.new-session-button {
  padding: 9rpx 20rpx;

  border: 1rpx solid #dbe3ee;
  border-radius: 100rpx;

  background: #ffffff;

  color: #64748b;
  font-size: 22rpx;
}

.new-session-button:active {
  background: #f1f5f9;
}